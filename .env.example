# ---------------------------------------------------------------------------
# Globe Harvest — environment template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# All values are read on the server. This project does not use any
# NEXT_PUBLIC_* variables, and the contact endpoint must never be exposed to
# the browser. Never commit .env.local or any other real environment file.
# ---------------------------------------------------------------------------

# Public value. Canonical origin of the deployed site, without a trailing slash.
# Required in production. Used by metadata, sitemap.xml, robots.txt and
# Open Graph URLs. Obtain it from your domain or hosting provider.
SITE_URL=https://your-domain.example

# Public values. Shown in the footer, contact page and email links.
# Optional locally; strongly recommended before launch. The site falls back to
# neutral placeholders when these are empty. Obtain them from the site owner.
BUSINESS_EMAIL=hello@example.com
BUSINESS_PHONE=+00 000 000 000
BUSINESS_ADDRESS=Your company name, street and number, postcode and city, country

# Secret server-side value. Multipart/form-data endpoint that receives contact
# enquiries, for example a Formspree form URL. Required only for live form
# delivery; leave empty to run in safe demonstration mode. Obtain it from your
# form provider. Consumed exclusively by src/app/api/contact/route.ts.
CONTACT_FORM_ENDPOINT=

# Public values. Optional social profile URLs. Leave empty to hide the links.
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=

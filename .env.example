# ---------------------------------------------------------------------------
# Globe Harvest — buyer configuration
# Copy this file to .env.local and fill in your own details.
# ---------------------------------------------------------------------------

# Canonical public URL of the deployed site (no trailing slash).
# Used for canonical links, Open Graph URLs, sitemap.xml and robots.txt.
SITE_URL=https://globeharvest.example

# Business contact details shown in the footer, contact page and emails.
BUSINESS_EMAIL=hello@your-company.com
BUSINESS_PHONE=+00 000 000 000
BUSINESS_ADDRESS=Your company name, street and number, postcode and city, country

# Contact-form delivery endpoint. Any endpoint that accepts multipart/form-data
# works, for example a Formspree form URL (https://formspree.io/f/xxxxxxxx).
# Leave empty to run the site in safe demonstration mode: the form is visibly
# disabled and the API refuses submissions instead of pretending to succeed.
CONTACT_FORM_ENDPOINT=

# Optional social profile links. Leave empty to hide the links entirely.
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=
